generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkspaceRole {
  OWNER
  MANAGER
  MEMBER
  VIEWER
}

enum ProjectStatus {
  ON_TRACK
  AT_RISK
  OFF_TRACK
  COMPLETED
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum ChannelType {
  PROJECT
  DIRECT
  TASK
}

enum NotificationType {
  TASK_ASSIGNED
  MENTION
  WATCHED_TASK_COMMENT
  DUE_SOON
  PROJECT_ADDED
  CHAT_MESSAGE
  WATCHED_TASK_UPDATED
  TASK_COMMENT
}

model User {
  id                     String            @id @db.Uuid
  name                   String
  email                  String            @unique
  avatarUrl              String?
  createdAt              DateTime          @default(now())
  workspacesCreated      Workspace[]       @relation("WorkspaceCreator")
  workspaceMemberships   WorkspaceMember[]
  invitationsSent        Invitation[]      @relation("InvitationInviter")
  sprintCapacities       SprintCapacity[]
  projectsLed            Project[]         @relation("ProjectLead")
  projectMemberships     ProjectMember[]
  assignedTasks          Task[]            @relation("TaskAssignee")
  reportedTasks          Task[]            @relation("TaskReporter")
  comments               Comment[]
  uploadedAttachments    Attachment[]
  activityLogs           ActivityLog[]
  channelMemberships     ChannelMember[]
  sentMessages           Message[]
  notifications          Notification[]
  taskWatches             TaskWatcher[]
}

model Workspace {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  slug         String            @unique
  createdById  String?           @db.Uuid
  createdAt    DateTime          @default(now())
  createdBy    User?             @relation("WorkspaceCreator", fields: [createdById], references: [id], onDelete: SetNull)
  members      WorkspaceMember[]
  invitations  Invitation[]
  projects     Project[]
  activityLogs ActivityLog[]
  channels     Channel[]

  @@index([createdById])
}

model WorkspaceMember {
  workspaceId String        @db.Uuid
  userId      String        @db.Uuid
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
}

model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @db.Uuid
  email       String?
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String?       @db.Uuid
  createdAt   DateTime      @default(now())
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?         @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@index([workspaceId, email])
}

model Project {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @db.Uuid
  name         String
  key          String
  description  String         @default("")
  leadId       String         @db.Uuid
  status       ProjectStatus  @default(ON_TRACK)
  startDate    DateTime?
  dueDate      DateTime?
  archived     Boolean        @default(false)
  taskCounter  Int            @default(0)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead         User           @relation("ProjectLead", fields: [leadId], references: [id], onDelete: Restrict)
  members      ProjectMember[]
  sprints      Sprint[]
  tasks        Task[]
  attachments  Attachment[]
  activityLogs ActivityLog[]
  channels     Channel[]

  @@unique([workspaceId, key])
  @@index([workspaceId, archived])
}

model ProjectMember {
  projectId String  @db.Uuid
  userId    String  @db.Uuid
  joinedAt  DateTime @default(now())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@index([userId])
}

model Sprint {
  id        String       @id @default(uuid()) @db.Uuid
  projectId String       @db.Uuid
  name      String
  goal      String       @default("")
  startDate DateTime
  endDate   DateTime
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]
  capacities SprintCapacity[]

  @@index([projectId, status])
}

model SprintCapacity {
  sprintId      String   @db.Uuid
  userId        String   @db.Uuid
  capacityPoints Int
  sprint        Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sprintId, userId])
  @@index([userId])
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @db.Uuid
  number         Int
  title          String
  description    String       @default("")
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  type           String       @default("TASK")
  labels         String[]     @default([])
  assigneeId     String?      @db.Uuid
  reporterId     String       @db.Uuid
  sprintId       String?      @db.Uuid
  estimatePoints Int?
  dueDate        DateTime?
  position       Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  completedAt    DateTime?
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter       User         @relation("TaskReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  sprint         Sprint?      @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  taskChannels   Channel[]    @relation("TaskChannel")
  checklistItems ChecklistItem[]
  comments       Comment[]
  attachments    Attachment[]
  activityLogs   ActivityLog[]
  watchers       TaskWatcher[]

  @@unique([projectId, number])
  @@index([projectId, status, position])
  @@index([assigneeId, status])
  @@index([sprintId])
}

model ChecklistItem {
  id      String  @id @default(uuid()) @db.Uuid
  taskId  String  @db.Uuid
  text    String
  done    Boolean @default(false)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model TaskWatcher {
  taskId    String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @default(now())
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
}

model Comment {
  id        String   @id @default(uuid()) @db.Uuid
  taskId    String   @db.Uuid
  authorId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([taskId, createdAt])
}

model Attachment {
  id           String   @id @default(uuid()) @db.Uuid
  taskId       String?  @db.Uuid
  projectId    String?  @db.Uuid
  /// Private Supabase Storage object path; never a public URL.
  fileUrl      String
  name         String
  size         Int
  uploadedById String   @db.Uuid
  createdAt    DateTime @default(now())
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  project      Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy   User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([taskId])
}

model ActivityLog {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @db.Uuid
  projectId   String?  @db.Uuid
  taskId      String?  @db.Uuid
  actorId     String   @db.Uuid
  action      String
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([workspaceId, createdAt])
  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
}

model Channel {
  id           String         @id @default(uuid()) @db.Uuid
  workspaceId  String         @db.Uuid
  projectId    String?        @db.Uuid
  taskId       String?        @unique @db.Uuid
  directKey    String?        @unique
  type         ChannelType
  name         String
  createdAt    DateTime       @default(now())
  workspace    Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task         Task?          @relation("TaskChannel", fields: [taskId], references: [id], onDelete: Cascade)
  members      ChannelMember[]
  messages     Message[]

  @@index([workspaceId, type])
}

model ChannelMember {
  channelId  String    @db.Uuid
  userId     String    @db.Uuid
  lastReadAt DateTime?
  channel    Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

model Message {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @db.Uuid
  senderId  String   @db.Uuid
  body      String
  createdAt DateTime @default(now())
  editedAt  DateTime?
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([channelId, createdAt])
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  type      NotificationType
  payload   Json
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
}
